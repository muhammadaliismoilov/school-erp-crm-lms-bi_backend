NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=*
TZ=Asia/Tashkent
DEFAULT_LOCALE=uz
TRUST_PROXY=false
BODY_LIMIT=1mb
SWAGGER_ENABLED=true
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=120

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=db
DATABASE_PASSWORD=dsdvsf432
DATABASE_NAME=dbname
DATABASE_SSL=false
TYPEORM_LOGGING=false
TYPEORM_SYNCHRONIZE=false
DATABASE_REPLICA_HOST=
DATABASE_REPLICA_PORT=5432
DATABASE_REPLICA_USER=
DATABASE_REPLICA_PASSWORD=
DATABASE_REPLICA_NAME=
POSTGRES_REPLICATION_PASSWORD=change-me-replication-password

REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=change-me-redis-password

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yuton-files
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-password
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/yuton-files

SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
METRICS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# AES-256-GCM key for confidential fields (e.g. psychologist session notes).
# Must be at least 32 characters in production. Generate with: openssl rand -base64 48
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-characters

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password
ADMIN_EMAIL=admin@yuton.local
DISABLE_BOOTSTRAP_SEED=false
